{
  "name": "@red-cup-engineering/serve-persistent-linux-machine-status-site",
  "version": "0.1.0",
  "type": "module",
  "description": "Serves one persistent Linux machine's Google-OAuth-gated status site — host health, processes, systemd units and recent agent-session activity as a FARS projection — plus the ActivityPub and x402 reverse proxies and the swarm-message relay that machine contracts, with every host name, origin, listener, activity dialect and proxied upstream read from one machine configuration file named by path.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "serve-persistent-linux-machine-status-site": "scripts/serve.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/fare": "0.1.0",
    "@red-cup-engineering/serve-google-oauth-service": "0.1.1",
    "@red-cup-engineering/session-activity-provider-service": "0.1.0",
    "@red-cup-engineering/session-transcript-dialects": "0.5.0",
    "@red-cup-engineering/systemd-unit-inventory-observation-service": "0.1.1",
    "@red-cup-engineering/file-services": "0.4.0",
    "@red-cup-engineering/computer-web-server": "*",
    "@red-cup-engineering/http-services-section": "*",
    "@red-cup-engineering/oauth-services-section": "0.1.0",
    "@red-cup-engineering/file-observation-services-section": "0.1.0"
  },
  "devDependencies": {},
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    "./machine-status-site-configuration": "./src/machine-status-site-configuration.mjs",
    "./collect-site-runtime-activity": "./src/collect-site-runtime-activity.mjs",
    "./machine-projection": "./src/machine-projection.mjs",
    "./machine-fars": "./src/machine-fars.mjs",
    "./status-site-page": "./src/status-site-page.mjs"
  }
}
