;; Execute the actual wrapper with closed effect ports, preserving its failure.
(use-modules (ice-9 match) (srfi srfi-1))
(call-with-input-file (string-append (dirname (car (command-line))) "/../scripts/github-machine-release.scm")
  (lambda (p)
    (let loop ((form (read p)))
      (unless (eof-object? form)
        (match form
          (('define ('receive-media . arguments) . body) (eval form (current-module)))
          (_ #f))
        (loop (read p))))))
(define calls '())
(define fail-media? #f)
(define fail-diagnostic? #f)
(define (effect kind args)
  (set! calls (append calls (list (cons kind args))))
  (cond
    ((any (lambda (word) (string-suffix? "/receive-production.mjs" word)) args)
     (when fail-media? (throw 'original-media-failure 'inert-original-detail)))
    ((any (lambda (word) (string-suffix? "/media-dependency-observation.mjs" word)) args)
     (when fail-diagnostic? (throw 'diagnostic-failure 'inert-unavailable)))
    (else (error "unexpected effect port"))))
(define (run . args) (effect 'local args))
(define (remote . args) (effect 'remote args))
(for-each
  (lambda (receiver)
    (for-each
      (lambda (failure)
        (set! calls '()) (set! fail-media? (car failure)) (set! fail-diagnostic? (cadr failure))
        (let* ((config (if receiver `(("receiverHost" . ,receiver)) '()))
               (result (catch #t (lambda () (receive-media config "/gnu/store/inert-artifact" "deploy") 'success)
                                (lambda (key . args) (cons key args)))))
          (unless (equal? result (if fail-media? '(original-media-failure inert-original-detail) 'success))
            (error "diagnostics masked original result"))
          (unless (= (length calls) (if fail-media? 2 1)) (error "unexpected observation/retry count"))
          (unless (every (lambda (call) (eq? (car call) (if receiver 'remote 'local))) calls)
            (error "receiver route changed"))
          (unless (equal? (last (cdr (car calls))) "receive") (error "media mode changed"))))
      '((#f #f) (#t #f) (#t #t))))
  '(#f "fixture-receiver"))
(set! calls '()) (set! fail-media? #f)
(receive-media '() "/gnu/store/inert-artifact" "build")
(unless (and (= (length calls) 1) (equal? (last (cdr (car calls))) "check"))
  (error "build mode gained activation or diagnostics"))
(display "Media wrapper: success, failure, diagnostic-failure and build controls passed with closed ports.\n")
