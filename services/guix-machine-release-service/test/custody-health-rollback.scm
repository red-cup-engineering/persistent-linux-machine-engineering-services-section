;; Run the actual receiver state machine on disposable files. Only external
;; supervisor/Guix/probe/credential actuators are inert; custody and code/unit
;; movement, caught live-check failure and rollback readback are real.
(use-modules (ice-9 match) (ice-9 popen) (ice-9 rdelim) (ice-9 ftw)
             (ice-9 textual-ports) (ice-9 regex) (ice-9 format) (json) (srfi srfi-1))
(call-with-input-file (string-append (dirname (car (command-line))) "/../scripts/receive.scm")
  (lambda (port) (let loop ((form (read port)))
    (unless (eof-object? form)
      (when (and (pair? form) (memq (car form) '(define define*))) (eval form (current-module)))
      (loop (read port))))))
(define actual-capture capture)
(define root (getenv "CUSTODY_FIXTURE_ROOT"))
(define store (string-append root "/candidate"))
(define held (string-append root "/held"))
(define config-file (string-append root "/machine.json"))
(define config (read-json config-file))
(define running? #t)
(define recovery-read? #f)
(define mode (or (getenv "CUSTODY_FIXTURE_MODE") "failed-forward"))
(define phase "forward")
(define target-health-attempted? #f)
(define (run . arguments) #t)
(define (system* . arguments) 0)
(define (retain-release-roots . arguments) #t)
(define (configuration-commands . arguments) #t)
(define (stop-owned-probe . arguments) #t)
(define (show-unit-journal . arguments) #t)
(define (probe-custody-environment . arguments) '())
(define (unit-active? . arguments) running?)
(define (unit-stop! . arguments) (set! running? #f))
(define (unit-restart! . arguments) (set! running? #t))
(define (units-reload! . arguments) #t)
(define (capture . arguments)
  (cond
    ((equal? (car arguments) "systemctl")
      (if running? "ActiveState=active\nMainPID=23\nControlPID=0\nControlGroup=\n"
          "ActiveState=inactive\nMainPID=0\nControlPID=0\nControlGroup=\n"))
    ((member "--input-type=module" arguments) "12345")
    ((any (lambda (word) (string-suffix? "credential-unit-receiving.mjs" word)) arguments) "{}")
    (else (apply actual-capture arguments))))
(define (body-read suffix expected)
  (unless (equal? (call-with-input-file (string-append root "/state/activitypub-native/" suffix) get-string-all) expected)
    (error "release code did not receive its readable custody")))
(define* (health url artifact #:optional pending)
  (when (equal? url "http://fixture/healthz")
    (cond
      ((and (equal? mode "failed-forward") (equal? artifact store))
        (call-with-output-file (string-append root "/state/activitypub-native/new-work.json")
          (lambda (port) (display "successor-only work\n" port)))
        (error "isolated candidate health failure"))
      ((and (equal? mode "failed-rollback") (equal? artifact held) (equal? phase "rollback"))
        (set! target-health-attempted? #t)
        (body-read "journal/data/journals/2026/10/11/feed.jsonl.witnesses" "original exact bytes\n")
        (call-with-output-file (string-append root "/state/activitypub-native/rollback-work.json")
          (lambda (port) (display "old-code new work\n" port)))
        (error "isolated rollback target health failure"))
      ((equal? artifact held)
        (when (equal? phase "rollback") (set! target-health-attempted? #t))
        (body-read "journal/data/journals/2026/10/11/feed.jsonl.witnesses" "original exact bytes\n")
        (set! recovery-read? #t))
      ((equal? artifact store)
        (body-read "journal/data/logs/feed-logs/feed.jsonl.witnesses" "original exact bytes\n")
        (when (equal? phase "rollback")
          (body-read "forward-work.json" "current-generation work\n")
          (set! recovery-read? #t)))
      (else (error "unadmitted health artifact")))))
(define (delete-file-recursively file)
  (if (eq? (stat:type (lstat file)) 'directory)
    (begin
      (for-each (lambda (name) (unless (member name '("." ".."))
        (delete-file-recursively (string-append file "/" name)))) (scandir file))
      (rmdir file))
    (delete-file file)))
(define failed? #f)
(if (equal? mode "failed-forward")
  (begin
    (catch #t (lambda () (receive config store #f #f config-file)) (lambda args (set! failed? #t)
      (format (current-error-port) "Fixture caught original receiver failure: ~s~%" args)))
    (unless (and failed? recovery-read? running?
                 (equal? (readlink (string-append root "/releases/current")) held)
                 (equal? (call-with-input-file (unit-file config (field config "unit")) get-string-all) "held unit\n"))
      (when (file-exists? (string-append root "/receipts/latest.json"))
        (display (call-with-input-file (string-append root "/receipts/latest.json") get-string-all) (current-error-port)))
      (error "actual receiver did not restore code, unit and readable state after health failure"))
    (display "Actual receiver live-check failure restored held code/unit and independently read original custody\n"))
  (begin
    (receive config store #f #f config-file)
    (unless (equal? (readlink (string-append root "/releases/current")) store) (error "forward promotion did not bind code"))
    (call-with-output-file (string-append root "/state/activitypub-native/forward-work.json")
      (lambda (port) (display "current-generation work\n" port)))
    ;; Ordinary scratch retention cannot erase generation/state correlation.
    (for-each (lambda (name)
      (when (string-prefix? ".probe-" name)
        (delete-file-recursively (string-append root "/releases/" name))))
      (scandir (string-append root "/releases")))
    (set! phase "rollback")
    (catch #t (lambda () (receive config held #f #f config-file #t))
      (lambda args (set! failed? #t)
        (format (current-error-port) "Fixture caught manual rollback failure: ~s~%" args)
        (for-each (lambda (name)
          (when (string-prefix? ".probe-" name)
            (let ((detail (string-append root "/releases/" name "/custody-transition.json.refusal.json")))
              (when (file-exists? detail)
                (display (call-with-input-file detail get-string-all) (current-error-port))))))
          (scandir (string-append root "/releases")))))
    (let ((expected (if (equal? mode "failed-rollback") store held))
          (expected-unit (if (equal? mode "failed-rollback") "candidate unit\n" "held unit\n")))
      (unless (and target-health-attempted? recovery-read? running?
                   (if (equal? mode "failed-rollback") failed? (not failed?))
                   (equal? (readlink (string-append root "/releases/current")) expected)
                   (equal? (call-with-input-file (unit-file config (field config "unit")) get-string-all) expected-unit))
        (when (file-exists? (string-append root "/receipts/latest.json"))
          (display (call-with-input-file (string-append root "/receipts/latest.json") get-string-all) (current-error-port)))
        (error "actual forward-success then rollback did not receive correlated code and state")))
    (display "Actual forward-success then rollback received correlated code and readable custody\n")))
