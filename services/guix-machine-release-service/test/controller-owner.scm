(use-modules (json) (ice-9 ftw))
(define test-directory (dirname (car (command-line))))
(load (string-append test-directory "/../src/controller-owner.scm"))
(define cases (call-with-input-file (string-append test-directory "/fixtures/controller-owner.json") json->scm))
(for-each
 (lambda (case)
   (let* ((result (catch #t
                    (lambda () (controller-owner (assoc-ref case "spec")))
                    (lambda args #f)))
          (accepted (and result #t)))
     (unless (eq? accepted (assoc-ref case "accepted"))
       (error "controller owner fixture failed" (assoc-ref case "name")))
     (when accepted
       (unless (and (equal? (assoc-ref result "repository") controller-repository-name)
                    (equal? (assoc-ref result "path") "."))
         (error "controller owner identity changed" (assoc-ref case "name"))))))
 (vector->list cases))
(format #t "controller-owner: ~a fixtures passed~%" (vector-length cases))

(define (must-refuse thunk label)
  (unless (catch #t (lambda () (thunk) #f) (lambda args #t))
    (error "controller directory unexpectedly admitted" label)))
(define root (mkdtemp (string-append (or (getenv "TMPDIR") "/tmp") "/controller-owner-XXXXXX")))
(dynamic-wind
 (lambda () #t)
 (lambda ()
   (let* ((repository (string-append root "/repo"))
          (outside (string-append root "/repo-other"))
          (nested (string-append repository "/nested")))
     (define (manifest directory name)
       (call-with-output-file (string-append directory "/package.json")
         (lambda (port) (scm->json `(("name" . ,name)) port))))
     (mkdir repository) (mkdir outside) (mkdir nested)
     (manifest repository "@red-cup-engineering/guix-machine-release-service")
     (manifest nested "@red-cup-engineering/guix-machine-release-service")
     (unless (equal? (controller-service-directory repository ".") (canonicalize-path repository))
       (error "standalone directory changed"))
     (unless (equal? (controller-service-directory repository "nested") (canonicalize-path nested))
       (error "nested directory changed"))
     (manifest nested "another/package")
     (must-refuse (lambda () (controller-service-directory repository "nested")) "wrong package")
     (manifest outside "@red-cup-engineering/guix-machine-release-service")
     (symlink outside (string-append repository "/escape"))
     (must-refuse (lambda () (controller-service-directory repository "escape")) "symlink escape")
     (must-refuse (lambda () (controller-service-directory repository "missing")) "missing directory")))
 (lambda () (system* "rm" "-rf" "--" root)))
(display "controller-owner: canonical directory and package identity fixtures passed\n")
