;; Read the actual owning forms without loading either release entry point.
;; Only the reviewed JSON helpers and invocation/candidate expressions are evaluated.
;; Their file effects use the caller’s private fixture root;
;; this is not a general Guile sandbox.
(use-modules (ice-9 match) (json) (srfi srfi-1))
(define fixture-root (cadr (command-line)))
(define source-root (string-append (dirname (car (command-line))) "/../scripts"))
(define (read-forms file)
  (call-with-input-file file
    (lambda (port)
      (let loop ((forms '()))
        (let ((form (read port)))
          (if (eof-object? form) (reverse forms) (loop (cons form forms))))))))
(define producer (read-forms (string-append source-root "/github-machine-release.scm")))
(define receiver (read-forms (string-append source-root "/receive.scm")))
(define (select-one forms predicate)
  (let ((found '()))
    (define (visit form)
      (when (predicate form) (set! found (cons form found)))
      (when (pair? form) (visit (car form)) (visit (cdr form))))
    (for-each visit forms)
    (unless (= (length found) 1) (error "expected exactly one owning form"))
    (car found)))
(define (definition? name)
  (lambda (form)
    (and (pair? form) (eq? (car form) 'define) (pair? (cdr form))
         (pair? (cadr form)) (eq? (caadr form) name))))
(define (write-call? suffix)
  (lambda (form)
    (and (pair? form) (eq? (car form) 'write-json) (pair? (cdr form))
         (equal? (cadr form) (list 'string-append 'work suffix)))))
(define producer-entry
  (select-one producer
    (lambda (form)
      (and (pair? form) (eq? (car form) 'match) (pair? (cdr form))
           (equal? (cadr form) '(cdr (command-line)))))))
;; Scope each producer arm by its actual dispatch signature. Native source
;; precedes legacy source, and each arm owns its own invocation expression.
(define (producer-clause signature)
  (select-one (cddr producer-entry)
    (lambda (form) (and (pair? form) (equal? (car form) signature)))))
(define producer-body
  (match (producer-clause '(snapshot work mode))
    ((('snapshot 'work 'mode) ('let* bindings . body)) body)
    (_ (error "legacy producer entry shape changed"))))
(define native-clause
  (producer-clause '(snapshot work mode software-file assembly-file source-snapshot)))
(unless (equal? (cdr native-clause)
  '((native-target snapshot work mode software-file assembly-file source-snapshot)))
  (error "native producer entry no longer calls its owning target constructor"))
(define native-producer-body
  (cddr (select-one producer (definition? 'native-target))))
(define invocation-call (select-one producer-body (write-call? "/release-invocation.json")))
(define candidate-call (select-one producer-body (write-call? "/candidate.json")))
(define native-invocation-call
  (select-one native-producer-body (write-call? "/release-invocation.json")))
(define native-candidate-call
  (select-one native-producer-body
    (write-call? '(if (equal? mode "rollback") "/prepared-target.json" "/candidate.json"))))
;; Check the real legacy sequence, rather than merely placing two copied
;; expressions into a test. Its early test/test-toolchain paths remain ahead.
(define invocation-index (list-index (lambda (form) (eq? form invocation-call)) producer-body))
(define test-index
  (list-index (lambda (form)
    (and (pair? form) (eq? (car form) 'when)
         (equal? (cadr form) '(member mode '("test" "test-toolchain"))))) producer-body))
(define rollback-index
  (list-index (lambda (form)
    (and (pair? form) (eq? (car form) 'when)
         (equal? (cadr form) '(equal? mode "rollback")))) producer-body))
(define (contains-candidate? form)
  (or (eq? form candidate-call)
      (and (pair? form)
           (or (contains-candidate? (car form)) (contains-candidate? (cdr form))))))
(define candidate-index (list-index contains-candidate? producer-body))
(unless (and invocation-index test-index rollback-index candidate-index
             (< test-index invocation-index rollback-index candidate-index))
  (error "invocation moved across the producer's existing early paths"))

;; Keep the genuine Guile JSON and file operations, with a fixed private root.
(define real-output call-with-output-file)
(define real-input call-with-input-file)
(define real-copy copy-file)
(define real-rename rename-file)
(define (private-path path)
  (unless (and (string? path)
               (string-prefix? (string-append fixture-root "/") path)
               (not (string-contains path "/../")))
    (error "fixture path escaped its private root"))
  path)
(define (call-with-output-file path proc) (real-output (private-path path) proc))
(define (call-with-input-file path proc) (real-input (private-path path) proc))
(define (copy-file from to) (real-copy (private-path from) (private-path to)))
(define (rename-file from to) (real-rename (private-path from) (private-path to)))
(define (closed . args) (error "release effect port is closed"))
(define run closed)
(define remote closed)
(define system* closed)
(define open-pipe* closed)
(define primitive-fork closed)
(define execle closed)
(define environment '())
(define (getenv name) (assoc-ref environment name))
(define (current-time) 1234)
(define snapshot "/inert/selected-machine")
(define revision (make-string 40 #\a))
(define (capture . args)
  (unless (equal? args (list "git" "-C" snapshot "rev-parse" "HEAD"))
    (error "unexpected capture; no process was started"))
  revision)
(eval (select-one producer (definition? 'write-json)) (current-module))
(eval (select-one producer (definition? 'read-json)) (current-module))
(eval (select-one receiver (definition? 'receipt)) (current-module))
(define work #f)
(define mode #f)
(define built `(("storePath" . "/gnu/store/inert-release")
                ("root" . "/inert/candidate-root")
                ("narSha256" . ,(make-string 64 #\b))))
(define (set-environment attempt)
  (set! environment `(("GITHUB_REPOSITORY" . "test/machine")
                      ("GITHUB_RUN_ID" . "123")
                      ("GITHUB_SHA" . ,(make-string 40 #\f))
                      ("GITHUB_RUN_ATTEMPT" . ,attempt))))
(for-each
  (lambda (selected-mode)
    (set! mode selected-mode)
    (for-each
      (lambda (case)
        (set! work (string-append fixture-root "/" mode "-" (car case)))
        (set-environment (cadr case))
        (eval invocation-call (current-module))
        (eval candidate-call (current-module))
        (set-environment (caddr case))
        (for-each
          (lambda (outcome)
            (let* ((stage (cond ((equal? outcome "staged") "pre-switch-check")
                                ((equal? outcome "success") "live-check")
                                ((equal? outcome "failure") "staging")
                                (else "restore-generation")))
                   (value `(("machine" . "machine") ("repository" . "test/machine")
                            ("revision" . ,revision)
                            ("run" . "https://github.com/test/machine/actions/runs/123")
                            ("storePath" . "/gnu/store/inert-release")
                            ("outcome" . ,outcome) ("stage" . ,stage)
                            ("at" . "2026-10-10T00:00:00Z")
                            ("originalStage" . "staging")
                            ("retained" . "/gnu/store/held-release"))))
              (receipt (string-append work "/" outcome) outcome value)))
          '("staged" "success" "failure" "recovery-failure")))
      '(("matched" "2" "2") ("missing" #f #f)
        ("invalid" "0" "0") ("mismatch" "2" "3"))))
  '("build" "deploy" "check-failure"))
;; These invocation modes do not take the candidate expression's build path.
(for-each
  (lambda (selected-mode)
    (set! mode selected-mode)
    (set! work (string-append fixture-root "/" mode "-invocation"))
    (set-environment "2")
    (eval invocation-call (current-module)))
  '("resolve" "rollback"))
;; Exercise each native output expression without evaluating fabrication or
;; receiving. Rollback emits prepared policy evidence, never a restored candidate.
(for-each
  (lambda (selected-mode)
    (set! mode selected-mode)
    (set! work (string-append fixture-root "/native-" mode))
    (set-environment "2")
    (eval native-invocation-call (current-module))
    (eval native-candidate-call (current-module)))
  '("build" "deploy" "check-failure" "rollback"))
(display "Release outcome Scheme forms: both producer arms, selected HEAD, candidate binding and receipt serialization passed.\n")
