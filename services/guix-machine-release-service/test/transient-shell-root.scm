;;; Execute the exact wrapper with a controlled Guix child. Its root must
;;; protect the child, then disappear on success and nonzero exit alike.
(use-modules (guix channels) (gcrypt base16) (json) (ice-9 popen)
             (ice-9 textual-ports) (ice-9 match) (ice-9 ftw)
             (srfi srfi-1) (srfi srfi-64))
(define wrapper (canonicalize-path (cadr (command-line))))
(define scratch (string-append "/tmp/guix-root-effect-" (number->string (getpid))))
(mkdir scratch #o700)
(define channels (string-append scratch "/channels.scm"))
(call-with-output-file channels (lambda (p) (display "(list)" p)))
(define root #f)
(define exit-code 0)
(define shell? #t)
(define caught? #f)
(module-define! (current-module) 'open-pipe* (lambda args (open-input-string "[]")))
(module-define! (current-module) 'close-pipe (lambda args 0))
(module-define! (current-module) 'command-line
  (lambda () (list wrapper channels (if shell? "shell" "build") "--" "true")))
(module-define! (current-module) 'system*
  (lambda (command . args)
    (set! root (find (lambda (a) (string-prefix? "--root=" a)) args))
    (when root
      (set! root (substring root 7))
      (test-assert "no pre-existing root overwritten" (not (false-if-exception (lstat root))))
      (symlink scratch root)
      (test-assert "root survives throughout child" (lstat root)))
    exit-code))
(test-begin "transient-shell-root")
(for-each
  (lambda (code)
    (set! exit-code code)
    (set! caught? #f)
    (catch #t (lambda () (primitive-load wrapper)) (lambda args (set! caught? #t)))
    (test-assert "child exit preserved" (eq? caught? (not (zero? code))))
    (test-assert "completed shell root retired" (and root (not (false-if-exception (lstat root))))))
  '(0 256))
(set! shell? #f)
(set! exit-code 0)
(primitive-load wrapper)
(test-assert "non-shell roots belong to caller" (not root))
(define failures (test-runner-fail-count (test-runner-current)))
(test-end "transient-shell-root")
(delete-file channels)
(rmdir scratch)
(exit (if (zero? failures) 0 1))
