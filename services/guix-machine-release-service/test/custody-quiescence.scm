;; Exercise the real owning controller predicates; no service is stopped.
(use-modules (ice-9 match) (ice-9 textual-ports) (json) (srfi srfi-1))
(call-with-input-file (string-append (dirname (car (command-line))) "/../scripts/receive.scm")
  (lambda (port)
    (let loop ((form (read port)))
      (unless (eof-object? form)
        (when (and (pair? form) (memq (car form) '(define define*)))
          (eval form (current-module)))
        (loop (read port))))))
(define (assert value label) (unless value (error label)))
(define config '(("unit" . "fixture.service")
                 ("custodyTransition" . (("writerUnits" . #("fixture.service"))))))
(define shown "ActiveState=inactive\nMainPID=0\nControlPID=0\nControlGroup=\n")
(define calls '())
(define (capture . arguments) (set! calls (cons arguments calls)) shown)
(define (run . arguments) (set! calls (cons arguments calls)))
(define (outcome thunk) (catch #t (lambda () (thunk) 'passed) (lambda _ 'refused)))
(assert (eq? (outcome (lambda () (stop-custody-writers config))) 'passed) "quiescent fixture refused")
(assert (equal? (reverse calls)
  '(("systemctl" "--user" "stop" "fixture.service")
    ("systemctl" "--user" "show" "fixture.service" "--property=ActiveState,MainPID,ControlPID,ControlGroup")))
  "controller did not stop then independently observe the writer")
(set! shown "ActiveState=active\nMainPID=23\nControlPID=0\nControlGroup=\n")
(assert (eq? (outcome (lambda () (assert-custody-quiescent config))) 'refused) "active writer admitted")
(set! shown "ActiveState=inactive\nMainPID=0\nControlPID=23\nControlGroup=\n")
(assert (eq? (outcome (lambda () (assert-custody-quiescent config))) 'refused) "remaining control process admitted")
(assert (eq? (outcome (lambda () (custody-writers '(("unit" . "fixture.service") ("custodyTransition" . (("writerUnits" . #("other.service")))))))) 'refused) "serving writer omission admitted")
(assert (null? (custody-writers '(("unit" . "masked-bcf.service")))) "absent transition changes masked machine")
(display "Owning controller stop/independent quiescence/refusal and absent-transition controls passed\n")
