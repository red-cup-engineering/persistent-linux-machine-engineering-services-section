;; Receive the actual producer's environment using the actual EnvironmentFile reader.
(use-modules (ice-9 textual-ports) (ice-9 rdelim) (ice-9 format) (ice-9 ftw) (srfi srfi-1) (json))
(call-with-input-file (string-append (dirname (car (command-line))) "/../scripts/receive.scm")
  (lambda (p)
    (let loop ((form (read p)))
      (unless (eof-object? form)
        (when (and (pair? form) (memq (car form) '(define define*)))
          (eval form (current-module)))
        (loop (read p))))))
(define (assert value message) (unless value (error message)))
(define root (mkdtemp (string-append (or (getenv "TMPDIR") "/tmp") "/probe-custody-XXXXXX")))
(define live (string-append root "/live.env"))
(define declared (string-append root "/declared.env"))
(define received (string-append root "/received.env"))
(define scratch (string-append root "/isolated"))
(define (write-text path text) (call-with-output-file path (lambda (p) (display text p))))
(define (receive declaration native?)
  (write-text declared declaration)
  (call-with-output-file received
    (lambda (p)
      (display (call-with-input-file live get-string-all) p)
      (display declaration p)
      (for-each (lambda (pair) (format p "~a=~s~%" (car pair) (cdr pair)))
                (probe-custody-environment (list live declared) scratch))))
  (let ((environment (environment-of (list received))))
    (assert (not (any (lambda (line) (string-contains line "/LIVE/")) environment))
            "probe retained a live custody or identity path")
    (assert (member (string-append "ACTIVITYPUB_STATE_DIR=" (if native? (string-append scratch "/activitypub-native") "")) environment)
            "native representation changed")
    (assert (member (string-append "ACTIVITYPUB_SQLITE_PATH=" (if native? "" (string-append scratch "/activitypub.sqlite"))) environment)
            "probe has conflicting custody representations")
    (for-each (lambda (pair)
                (assert (member (string-append (car pair) "=" scratch "/" (cdr pair)) environment)
                        "identity custody escaped scratch"))
              '(("ACTIVITYPUB_KEYS_DIRECTORY" . "activitypub-keys")
                ("ACTIVITYPUB_KEYS_PATH" . "activitypub-key.json")
                ("ACTIVITYPUB_INBOX_BEARER_TOKEN_FILE" . "bearer-token")))))
(dynamic-wind
  (lambda ()
    (write-text live "ACTIVITYPUB_STATE_DIR=\"/LIVE/native\"\nACTIVITYPUB_SQLITE_PATH=/LIVE/old.sqlite\nACTIVITYPUB_KEYS_DIRECTORY=/LIVE/keys\nACTIVITYPUB_KEYS_PATH=/LIVE/key.json\nACTIVITYPUB_INBOX_BEARER_TOKEN_FILE=/LIVE/token\n"))
  (lambda ()
    (receive "" #t)
    (receive "ACTIVITYPUB_STATE_DIR=\"/LIVE/successor\"\n" #t)
    (receive "ACTIVITYPUB_STATE_DIR=\"\"\n" #f)
    (receive "ACTIVITYPUB_STATE_DIR=\"   \"\n" #f)
    (write-text live "ACTIVITYPUB_SQLITE_PATH=/LIVE/old.sqlite\n")
    (receive "" #f)
    ;; Exercise the receiver's real terminal guard and health loop, not a
    ;; shortened timeout. Known termination refuses before any curl request.
    (let ((state "failed") (loaded "loaded") (queries 0) (stops 0))
      (set! capture (lambda args
        (assert (and (equal? (take args 3) '("systemctl" "--user" "show"))
                     (equal? (last args) "owned-inert-probe")) "unexpected probe observation")
        (set! queries (+ queries 1))
        (cond ((member "--property=ActiveState" args) state)
              ((member "--property=LoadState" args) loaded)
              (else (error "unexpected observation field")))))
      (for-each (lambda (terminal)
        (set! state terminal)
        (assert (catch #t
          (lambda () (health "http://unused.invalid" "/gnu/store/inert"
                            (lambda () (owned-probe-pending "owned-inert-probe"))) #f)
          (lambda _ #t)) "terminal probe kept waiting")) '("failed" "inactive"))
      (assert (= queries 2) "terminal probe reached curl or retried")
      (set! state "activating")
      (owned-probe-pending "owned-inert-probe")
      (set! state "active")
      (owned-probe-pending "owned-inert-probe")
      (set! run (lambda args
        (assert (equal? args '("systemctl" "--user" "stop" "owned-inert-probe")) "unexpected probe effect")
        (set! stops (+ stops 1)) (error "inert stop failure")))
      (set! loaded "not-found")
      (stop-owned-probe "owned-inert-probe")
      (assert (= stops 0) "collected probe was stopped again")
      (set! loaded "loaded")
      (assert (catch #t (lambda () (stop-owned-probe "owned-inert-probe") #f) (lambda _ #t))
              "actual probe stop failure was hidden")
      (assert (= stops 1) "actual stop was not attempted"))
    (display "Actual probe storage representation and private identity isolation passed.\n"))
  (lambda ()
    (for-each (lambda (path) (when (file-exists? path) (delete-file path))) (list live declared received))
    (rmdir root)))
