;; Exercise the actual source helper and its local call site, with closed ports.
(use-modules (ice-9 match) (srfi srfi-1))
(define helper #f)
(define local-call #f)
(define (inspect form)
  (match form
    (('define ('receive-local-media . arguments) . body) (set! helper form))
    (('when ('and ('not ('equal? 'mode "rollback"))
                  ('assoc-ref 'config "mediaReceipt")
                  ('not ('assoc-ref 'config "receiverHost")))
             ('receive-local-media 'config 'store 'mode 'snapshot))
     (set! local-call form))
    (_ #f))
  (when (pair? form) (inspect (car form)) (inspect (cdr form))))
(call-with-input-file (string-append (dirname (car (command-line))) "/../scripts/github-machine-release.scm")
  (lambda (port)
    (let loop ((form (read port)))
      (unless (eof-object? form) (inspect form) (loop (read port))))))
(unless (and helper local-call) (error "preflight owner and guarded call site required"))
(eval helper (current-module))
(define calls '())
(define fail-host? #f)
(define fail-media? #f)
(define real-host? #f)
(define (run . args)
  (set! calls (append calls (list (cons 'host args))))
  (unless (equal? args
                 (list (string-append store "/bin/node")
                       (string-append store "/.controller/scripts/check-host.mjs") store))
    (error "unexpected preflight command"))
  (when (or fail-host? (and real-host? (not (zero? (apply system* args)))))
    (throw 'original-host-check-failure)))
(define (receive-media . args)
  (set! calls (append calls (list (cons 'media args))))
  (when fail-media? (throw 'original-media-failure)))
(define config '())
(define store "/gnu/store/inert-candidate")
(define mode "deploy")
(define snapshot "/inert/current-machine")
(define (invoke)
  (catch #t (lambda () (eval local-call (current-module)) 'success)
    (lambda (key . args) key)))
(for-each
  (lambda (selected-mode)
    (set! mode selected-mode)
    (for-each
      (lambda (selected-config)
        (set! config selected-config) (set! calls '())
        (unless (eq? (invoke) 'success) (error "valid candidate rejected"))
        (let* ((selected? (and (not (equal? mode "rollback"))
                              (assoc-ref config "mediaReceipt")
                              (not (assoc-ref config "receiverHost"))))
               (expected (if selected? (if (equal? mode "deploy") '(host media) '(media)) '())))
          (unless (equal? (map car calls) expected) (error "local/media/mode ordering changed"))
          (when selected?
            (unless (equal? (cdr (last calls)) (list config store mode))
              (error "media arguments changed")))))
      '(() (("mediaReceipt" . #t)) (("mediaReceipt" . #t) ("receiverHost" . "fixture-remote")))))
  '("deploy" "build" "check-failure" "rollback"))
(set! config '(("mediaReceipt" . #t))) (set! mode "deploy")
(set! calls '()) (set! fail-host? #t)
(unless (and (eq? (invoke) 'original-host-check-failure)
             (equal? (map car calls) '(host)))
  (error "rejected host candidate reached media activation"))
(set! calls '()) (set! fail-host? #f) (set! fail-media? #t)
(unless (and (eq? (invoke) 'original-media-failure)
             (equal? (map car calls) '(host media)))
  (error "media failure was hidden or replayed"))
;; Run the real, unchanged Node check-host against an incomplete candidate.
;; Its missing declared driver must fail before receiving or media activation.
(set! calls '()) (set! fail-media? #f) (set! real-host? #t)
(set! store (cadr (command-line)))
(unless (and (eq? (invoke) 'original-host-check-failure)
             (equal? (map car calls) '(host)))
  (error "actual invalid sealed candidate reached media"))
(display "Local host preflight: ordering, failure, unchanged modes/routes and actual invalid candidate passed.\n")
