;; Exercise the actual receiver function with temporary inert files and closed effect ports.
;; Never load the script's command-line dispatch or perform a real service action.
(use-modules (ice-9 match) (ice-9 popen) (ice-9 rdelim) (ice-9 ftw) (ice-9 textual-ports)
             (ice-9 format) (json) (srfi srfi-1))
(define source (string-append (dirname (car (command-line))) "/../scripts/receive.scm"))
(call-with-input-file source
  (lambda (p)
    (let loop ((form (read p)))
      (unless (eof-object? form)
        (when (and (pair? form) (memq (car form) '(define define*)))
          (eval form (current-module)))
        (loop (read p))))))
(define (assert value message) (unless value (error message)))
(define (write-text path text) (call-with-output-file path (lambda (p) (display text p))))
(define (write-json path value) (call-with-output-file path (lambda (p) (scm->json value p))))
(define (remove-fixture path)
  (if (eq? (stat:type (lstat path)) 'directory)
    (begin (for-each (lambda (name) (unless (member name '("." ".."))
                       (remove-fixture (string-append path "/" name)))) (scandir path))
           (rmdir path))
    (delete-file path)))
;; Reproduces the observed recovery: successful pre-switch stop followed by
;; live-check failure and recovery cleanup. A collected unit cannot be stopped again.
(let* ((calls 0)
       (stop (make-probe-stop (lambda ()
               (set! calls (+ calls 1))
               (when (> calls 1) (error "probe unit is no longer loaded"))))))
  (stop)
  (stop)
  (stop)
  (assert (= calls 1) "recovery repeated a successfully completed termination"))
;; A failure is not termination evidence. Recovery must retry and must retain
;; the error when that retry also fails; it cannot mark the effect complete early.
(let* ((calls 0) (allow? #f)
       (stop (make-probe-stop (lambda ()
               (set! calls (+ calls 1))
               (unless allow? (error "fixture:termination refused"))))))
  (assert (catch #t (lambda () (stop) #f) (lambda args #t)) "first termination failure disappeared")
  (assert (catch #t (lambda () (stop) #f) (lambda args #t)) "repeated termination failure disappeared")
  (assert (= calls 2) "failed cleanup was silently marked complete")
  (set! allow? #t)
  (stop)
  (stop)
  (assert (= calls 3) "received termination was retried"))
(display "Owned probe cleanup replay and failure receiving passed.\n")

(define original-home (getenv "HOME"))
(define observations '())
(define fail-proof? #f)
(define recovering? #f)
(define fault #f)
(define held-artifact #f)
(define command-metadata-available? #t)
(define failure-key 'original-credential-failure)
(define failure-detail 'INERT_ORIGINAL_PRIVATE)
(define original-atomic-copy atomic-copy)
(define original-atomic-link atomic-link)
(define original-receipt receipt)
(define original-run run)
(define (injected step)
  (when (and recovering? (equal? fault step))
    (throw 'recovery-error 'INERT_RECOVERY_PRIVATE)))
(set! atomic-copy (lambda args
  (when (string-contains (car args) "/managed-") (injected "restore-managed-files"))
  (when (string-suffix? "/main.unit" (car args)) (injected "restore-main-unit"))
  (apply original-atomic-copy args)))
(set! atomic-link (lambda args
  (when (string-suffix? "/current" (car args)) (injected "restore-generation"))
  (apply original-atomic-link args)))
(set! receipt (lambda args
  (record (list 'receipt (cadr args)))
  (injected "failure-receipt")
  (when (equal? (cadr args) "recovery-failure") (injected "recovery-receipt"))
  (apply original-receipt args)))
(define (record x) (set! observations (append observations (list x))))
;; These lexical bindings are used by the extracted, otherwise unchanged receive function.
(set! run (lambda args
  (unless (or (member (car args) '("systemctl" "systemd-run" "guix" "mkdir"))
              (string-suffix? "/bin/node" (car args))) (error "unexpected effect" (car args)))
  (record (cons 'run args))
  (when (and (equal? fault "host-check") (any (lambda (arg) (string-suffix? "/check-host.mjs" arg)) args))
    (set! recovering? #t) (throw failure-key failure-detail))
  ;; A real stop failure occurs while the probe is still owned. A successful
  ;; earlier stop is not made uncertain by a later injected credential failure.
  (when (and (not recovering?) (equal? fault "probe-stop")
             (equal? (take args 3) '("systemctl" "--user" "stop"))
             (string-prefix? "fixture-guix-probe-" (last args)))
    (set! recovering? #t) (throw failure-key failure-detail))
  (apply original-run args)))
(set! capture (lambda args
  (unless (or (string-suffix? "/bin/node" (car args))
              (and (equal? (take args 4) '("systemctl" "--user" "show" "--property=LoadState"))
                   (equal? (list-ref args 4) "--value")
                   (string-prefix? "fixture-guix-probe-" (last args)))
              (and (equal? (take args 4) '("systemctl" "--user" "show" "--property=ActiveState"))
                   (equal? (list-ref args 4) "--value")
                   (string-prefix? "fixture-guix-probe-" (last args))))
    (error "unexpected observation" (car args)))
  (record (cons 'capture args))
  (cond ((member "--property=LoadState" args) "loaded")
        ((member "--property=ActiveState" args) "active")
        ((member "--input-type=module" args) "18181")
        ((member "baseline" args) "{\"status\":\"baseline\",\"started\":\"100\"}")
        ((member "verify" args) (if (or fail-proof? (not command-metadata-available?)) (begin (set! recovering? #t) (throw failure-key failure-detail))
                                    "{\"status\":\"received\",\"Result\":\"success\",\"ExecMainStatus\":0}"))
        (else (error "unexpected capture arguments")))))
(set! system* (lambda args
  (unless (or (member (car args) '("systemctl" "systemd-run" "guix" "mkdir"))
              (string-suffix? "/bin/node" (car args))) (error "unexpected system effect"))
  (record (cons 'system args))
  (when (and (not recovering?) (equal? fault "main-restart")
             (equal? args '("systemctl" "--user" "restart" "fixture-main.service")))
    (set! recovering? #t) (throw failure-key failure-detail))
  ;; Exercise the receiver's real run status check against inert process results.
  (if (or (and recovering?
          (or
            (and (member fault '("probe-stop" "collected-probe")) (equal? (take args 3) '("systemctl" "--user" "stop"))
                 (string-prefix? "fixture-guix-probe-" (last args)))
            (and (equal? fault "restore-auxiliary-stop") (equal? args '("systemctl" "--user" "stop" "561-group-credentials.service")))
            (and (equal? fault "restore-daemon-reload") (equal? args '("systemctl" "--user" "daemon-reload")))
            (and (equal? fault "restore-auxiliary-restart") (equal? args '("systemctl" "--user" "restart" "561-group-credentials.service")))
            (and (member fault '("restore-main-restart" "recovery-receipt")) (equal? args '("systemctl" "--user" "restart" "fixture-main.service")))))
          (and (equal? fault "prior-inactive") (equal? args '("systemctl" "--user" "is-active" "--quiet" "fixture-main.service"))))
    256 0)))
(set! health (lambda* (url #:optional expected-artifact pending-check)
  (when pending-check (pending-check))
  (record (list 'health url expected-artifact))
  (injected "restore-live-check")
  ;; Use the real predicate against an independent observation, rather than
  ;; echoing the receiver's argument and thereby hiding an unbound health call.
  (let ((reading
          (if recovering?
            (cond ((equal? fault "restore-live-check-missing-artifact") '(("ok" . #t)))
                  ((equal? fault "restore-live-check-wrong-artifact") '(("ok" . #t) ("artifact" . "/gnu/store/foreign")))
                  (else `(("ok" . #t) ("artifact" . ,held-artifact))))
            `(("ok" . #t) ("artifact" . ,expected-artifact)))))
    (unless (admitted-health-reading? reading expected-artifact)
      (throw 'recovery-error 'INERT_RECOVERY_PRIVATE)))
  #t))
(set! configuration-commands (lambda args
  (record (list 'configuration (cadr args) (if recovering? 'recovery 'candidate)))
  (when (and (not recovering?) (equal? (cadr args) "reload"))
    (when (equal? fault "reload-clears-command") (set! command-metadata-available? #f))
    (when (equal? fault "configuration-reload")
      (set! recovering? #t) (throw failure-key failure-detail)))
  (injected "restore-configuration-reload") #t))
(set! retain-release-roots (lambda args #t))
(set! root-release-generations (lambda args #t))

(for-each (lambda (scenario)
  (set! observations '())
  (set! fail-proof? (not (member scenario '(success "reload-clears-command" "configuration-reload" "main-restart"))))
  (set! command-metadata-available? #t)
  (set! recovering? #f) (set! fault scenario)
  (let* ((root (mkdtemp (string-append (or (getenv "TMPDIR") "/tmp") "/credential-receiving-XXXXXX")))
         (home (string-append root "/home"))
         (config-dir (string-append home "/.config"))
         (systemd-dir (string-append config-dir "/systemd"))
         (user-dir (string-append systemd-dir "/user"))
         (releases (string-append root "/releases"))
         (receipts (string-append root "/receipts"))
         (store (string-append root "/candidate"))
         (metadata (string-append store "/.metadata"))
         (units (string-append store "/.guix-systemd"))
         (prior (string-append root "/prior"))
         (prior-target (if (equal? scenario "relative-prior") "../prior"
                           (if (equal? scenario "aliased-prior") (string-append root "/held-alias") prior)))
         (older (string-append root "/older"))
         (main "fixture-main.service") (aux "561-group-credentials.service")
         (environment (string-append root "/inert.env"))
         (config-file (string-append root "/machine.json"))
         (config `(("name" . "fixture") ("unit" . ,main) ("releaseRoot" . ,releases)
                   ("receiptRoot" . ,receipts) ("environmentFile" . ,environment)
                   ("stateCompatibility" . "preserve-existing") ("repository" . "fixture/machine")
                   ("health" . "http://example.invalid/never-called") ("guixProfile" . ,(string-append root "/profile"))
                   ("auxiliaryUnits" . #( "561-group-credentials.service"))
                   ("restartAuxiliaryUnits" . #( "561-group-credentials.service")))))
    (for-each mkdir (list home config-dir systemd-dir user-dir releases receipts store metadata units prior older))
    (setenv "HOME" home)
    (set! held-artifact prior)
    (when (equal? scenario "aliased-prior") (symlink prior prior-target))
    (write-json config-file config)
    (write-text environment "INERT_FIXTURE=1\n")
    (write-text (string-append units "/environment") "INERT_GENERATION=1\n")
    (write-text (string-append units "/" main) "candidate main")
    (write-text (string-append units "/" aux) "candidate auxiliary")
    (write-text (string-append user-dir "/" main) "held main")
    (write-text (string-append user-dir "/" aux) "held auxiliary")
    (unless (equal? scenario "restore-generation-unavailable")
      (symlink prior-target (string-append releases "/current")))
    (symlink older (string-append releases "/previous"))
    (write-json (string-append metadata "/release.json")
      `(("machineCommit" . ,(make-string 40 #\a)) ("machineRepository" . "fixture/machine")))
    (let* ((output (open-output-string))
           (errors (open-output-string))
           (result (parameterize ((current-output-port output) (current-error-port errors))
                     (catch #t (lambda () (receive config store #f #f config-file) 'received)
                               (lambda args args))))
           (latest (string-append receipts "/latest.json"))
           (reading (and (file-exists? latest) (read-json latest))))
      (if (not (member scenario '(success "reload-clears-command")))
        (begin
          (assert (equal? result (list failure-key failure-detail)) "original failure was masked")
          (assert (member '(receipt "failure") observations) "original failure receipt not attempted")
          (assert (not (member '(configuration "receive" candidate) observations)) "false capability receiving after failure")
          (unless (equal? scenario "configuration-reload")
            (assert (not (member '(configuration "reload" candidate) observations)) "configuration reload preceded strict credential proof"))
          (when (equal? scenario "main-restart")
            (assert (not (any (lambda (call) (and (eq? (car call) 'capture) (member "verify" call))) observations))
                    "credential proof ran after failed restart"))
          (unless (equal? scenario "failure-receipt")
            (assert (equal? (assoc-ref reading "outcome") "failure") "failure receipt absent")
            (assert (equal? (assoc-ref reading "stage")
                            (cond ((equal? scenario "host-check") "host-check")
                                  ((equal? scenario "main-restart") "switch")
                                  ((equal? scenario "configuration-reload") "configuration-reload")
                                  ((equal? scenario "probe-stop") "pre-switch-check")
                                  (else "credential-unit-check"))) "original failure stage differs")
            (let* ((recovery (assoc-ref reading "recovery"))
                   (failed (vector->list (assoc-ref recovery "failedSteps"))))
              (assert (equal? (assoc-ref recovery "expectedArtifact")
                              (and (not (equal? scenario "restore-generation-unavailable")) prior))
                      "recovery expected artifact was not captured from the held generation")
              (if (member scenario '("none" "relative-prior" "aliased-prior" "configuration-reload" "main-restart" "host-check" "prior-inactive" "failure-receipt" "collected-probe"))
                (begin
                  (assert (equal? (assoc-ref recovery "status") (if (equal? scenario "host-check") "not-required" "steps-completed")) "recovery steps not recorded")
                  (assert (equal? (assoc-ref recovery "liveCheck") (if (member scenario '("host-check" "prior-inactive")) "not-attempted" "passed")) "recovery live check absent"))
                (begin
                  (assert (equal? (assoc-ref recovery "status") "incomplete") "incomplete recovery was hidden")
                  (assert (member (cond ((equal? scenario "recovery-receipt") "restore-main-restart")
                                        ((member scenario '("restore-live-check-missing-artifact" "restore-live-check-wrong-artifact")) "restore-live-check")
                                        (else scenario)) failed)
                          "failed recovery step differs")
                  (when (member scenario '("restore-live-check-missing-artifact" "restore-live-check-wrong-artifact"))
                    (assert (equal? (assoc-ref recovery "liveCheck") "failed") "foreign or unbound health was accepted"))
                  (assert (member '(receipt "recovery-failure") observations) "separate recovery failure not attempted"))))
            (assert (not (string-contains (call-with-input-file latest get-string-all) "INERT_")) "private exception leaked to receipt"))
          (for-each
            (lambda (file)
              (when (string-suffix? ".json" file)
                (let* ((text (call-with-input-file (string-append receipts "/" file) get-string-all))
                       (value (json-string->scm text)))
                  (assert (not (string-contains text "INERT_")) "private exception leaked to durable receipt")
                  (assert (equal? (assoc-ref value "revision") (make-string 40 #\a)) "failure correlation changed")
                  (when (equal? (assoc-ref value "outcome") "recovery-failure")
                    (assert (equal? (assoc-ref value "originalStage") (if (equal? scenario "probe-stop") "pre-switch-check" "credential-unit-check")) "recovery lost original failure stage")))))
            (scandir receipts))
          (assert (not (string-contains (get-output-string output) "INERT_")) "private exception leaked to stdout")
          (assert (not (string-contains (get-output-string errors) "INERT_")) "private exception leaked to stderr")
          (when (member scenario '("none" "relative-prior" "aliased-prior" "configuration-reload" "main-restart" "host-check" "prior-inactive" "probe-stop" "failure-receipt" "recovery-receipt" "restore-daemon-reload"
                                  "restore-configuration-reload" "restore-auxiliary-restart" "restore-main-restart" "restore-live-check"
                                  "restore-live-check-missing-artifact" "restore-live-check-wrong-artifact"))
            (assert (equal? (readlink (string-append releases "/current")) prior-target) "held code not restored")
            (assert (equal? (readlink (string-append releases "/previous")) older) "held previous not restored")
            (assert (equal? (call-with-input-file (string-append user-dir "/" main) get-string-all) "held main") "main unit not restored")
            (assert (equal? (call-with-input-file (string-append user-dir "/" aux) get-string-all) "held auxiliary") "auxiliary unit not restored"))
          ;; An earlier prerequisite failure cannot be bypassed to restart the main service.
          (let ((restarts (filter (lambda (call) (equal? call '(run "systemctl" "--user" "restart" "fixture-main.service"))) observations)))
            (assert (= (length restarts)
                       (if (member scenario '("host-check" "probe-stop")) 0
                         (if (member scenario '("prior-inactive" "restore-generation-unavailable" "restore-auxiliary-stop" "restore-managed-files" "restore-generation"
                                              "restore-main-unit" "restore-daemon-reload" "restore-configuration-reload"
                                              "restore-auxiliary-restart")) 1 2)))
                    "activation continued after failed recovery prerequisite"))
          (when (member scenario '("prior-inactive" "restore-generation-unavailable" "restore-auxiliary-stop" "restore-managed-files" "restore-generation" "restore-main-unit"
                                  "restore-daemon-reload" "restore-configuration-reload" "restore-auxiliary-restart"
                                  "restore-main-restart" "recovery-receipt"))
            (assert (= (count (lambda (call) (eq? (car call) 'health)) observations) 1)
                    "live check continued after failed recovery prerequisite")))
        (begin
          (assert (eq? result 'received) "valid proof refused")
          (let ((verify (find (lambda (call) (and (eq? (car call) 'capture) (member "verify" call))) observations)))
            (assert verify "credential proof absent")
            (let ((before (take observations (- (length observations) (length (member verify observations))))))
              (assert (and (member '(run "systemctl" "--user" "restart" "fixture-main.service") before)
                           (member '(run "systemctl" "--user" "restart" "561-group-credentials.service") before))
                      "credential proof preceded its admitted restarts"))
            (assert (member '(configuration "reload" candidate) (member verify observations))
                    "credential proof did not precede configuration reload")
            (assert (member (list 'health (assoc-ref config "health") store)
                            (member '(configuration "reload" candidate) observations))
                    "candidate-bound live health did not follow configuration reload"))
          (assert (equal? (assoc-ref reading "outcome") "success") "success receipt absent")
          (assert (equal? (assoc-ref (assoc-ref reading "credentialUnit") "status") "received") "value-free proof not retained")
          (assert (equal? (readlink (string-append releases "/current")) store) "candidate not retained in inert fixture"))))
    (format #t "Receiver ~a path passed with closed effect ports.~%" scenario)
    (if original-home (setenv "HOME" original-home) (unsetenv "HOME"))
    (remove-fixture root)))
  '(success "reload-clears-command" "configuration-reload" "main-restart" "restore-main-restart" "none" "relative-prior" "aliased-prior" "host-check" "prior-inactive" "restore-generation-unavailable" "probe-stop" "collected-probe" "restore-auxiliary-stop" "restore-managed-files" "restore-generation"
    "restore-main-unit" "restore-daemon-reload" "restore-configuration-reload" "restore-auxiliary-restart"
    "restore-live-check" "restore-live-check-missing-artifact" "restore-live-check-wrong-artifact" "recovery-receipt" "failure-receipt"))
